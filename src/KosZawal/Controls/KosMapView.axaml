<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
             x:Class="KosZawal.Controls.KosMapView">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="4,0,4,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="OsmButton" Classes="action" Content="Ośrodki KOS" Click="ShowOsm" />
        <Button x:Name="LeadersButton" Classes="quiet" Content="Tylko liderzy" Click="ShowLeaders" />
        <Button x:Name="AdminButton" Classes="quiet" Content="Administracyjna" Click="ShowAdmin" />
      </StackPanel>
      <TextBlock x:Name="HintText" Classes="muted" TextWrapping="Wrap"
                 Text="Mapa Polski (kraje ościenne ukryte). Korona = lider województwa. Kliknij punkt, by zobaczyć szczegóły." />
    </StackPanel>
    <Border Background="#F3F0E8" CornerRadius="12" ClipToBounds="True">
      <mapsui:MapControl x:Name="MapControl" MinHeight="640" />
    </Border>
  </DockPanel>
</UserControl>
