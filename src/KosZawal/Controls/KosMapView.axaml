<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
             x:Class="KosZawal.Controls.KosMapView">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="4,0,4,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="OsmButton" Classes="action" Content="OpenStreetMap · ośrodki" Click="ShowOsm" />
        <Button x:Name="AdminButton" Classes="quiet" Content="Administracyjna" Click="ShowAdmin" />
        <Button x:Name="LeadersButton" Classes="quiet" Content="Liderzy województw" Click="ShowLeaders" />
      </StackPanel>
      <TextBlock x:Name="HintText" Classes="muted" TextWrapping="Wrap"
                 Text="Kafelki OpenStreetMap. Punkty: ośrodki KOS-zawał (złoty = położenie przybliżone)." />
    </StackPanel>
    <Border Background="#E7E1D6" CornerRadius="12" ClipToBounds="True">
      <mapsui:MapControl x:Name="MapControl" MinHeight="640" />
    </Border>
  </DockPanel>
</UserControl>
