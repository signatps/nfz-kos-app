<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:KosZawal.Controls"
        x:Class="KosZawal.SplashWindow"
        Width="560" Height="380"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="#122433"
        Title="KOS-zawał">
  <Grid RowDefinitions="*,Auto" Margin="36">
    <StackPanel Spacing="14" VerticalAlignment="Center">
      <Border Width="84" Height="84" CornerRadius="28" Background="#0E6E6A">
        <controls:Pictogram Kind="heart" Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
      </Border>
      <TextBlock Text="KOS-ZAWAŁ" FontSize="34" FontWeight="SemiBold" Foreground="White" LetterSpacing="1.4" />
      <TextBlock Text="Zawały serca i program KOS-zawał&#x0a;według publicznego raportu NFZ" Foreground="#D7E4EC" FontSize="15" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="8">
      <TextBlock x:Name="StatusText" Text="Uruchamianie…" Foreground="#9FB4C2" FontSize="13" />
      <ProgressBar IsIndeterminate="True" Height="3" Foreground="#C4474F" Background="#1B3C55" />
    </StackPanel>
  </Grid>
</Window>
